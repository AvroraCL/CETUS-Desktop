<Window x:Class="Cetus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Cetus · 鲸鱼座"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">
    <Grid>
        <!-- The official DeepSeek Harness web UI, rendered unmodified.
             Source is assigned in code after the custom WebView2 environment
             (isolated user data folder) is created. -->
        <wv2:WebView2 x:Name="Browser" />

        <!-- Startup overlay: shown until the backend is ready and the page loads. -->
        <Border x:Name="Splash" Background="#F7F9FC" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🐋" FontSize="56" HorizontalAlignment="Center" />
                <TextBlock Text="Cetus · 鲸鱼座" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock x:Name="SplashStatus" Text="正在启动…" FontSize="13"
                           Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <ProgressBar IsIndeterminate="True" Width="240" Height="4" />

                <StackPanel x:Name="FailurePanel" Orientation="Horizontal" Visibility="Collapsed"
                            HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="重试" Width="88" Height="30" Margin="0,0,12,0" Click="OnRetryClick" />
                    <Button Content="退出" Width="88" Height="30" Click="OnQuitClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
