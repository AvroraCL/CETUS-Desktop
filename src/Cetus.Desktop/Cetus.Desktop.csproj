<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Cetus</AssemblyName>
    <RootNamespace>Cetus</RootNamespace>
    <ApplicationIcon>Assets\cetus.ico</ApplicationIcon>
    <Version>0.1.7</Version>
    <FileVersion>0.0.1.7</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>CETUS鲸鱼座</Product>
    <Copyright>AvroraCL</Copyright>
    <Description>DeepSeek Harness Windows desktop shell</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cetus.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms implicit usings collide with WPF's Application; MainWindow imports them explicitly. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- The custom title bar reuses the application's packaged icon. -->
    <Resource Include="Assets\cetus.ico" />
    <Resource Include="Assets\logo.svg" />
    <Resource Include="Assets\heclm-logo.svg" />
  </ItemGroup>

</Project>
