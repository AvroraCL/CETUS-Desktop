<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Cetus</AssemblyName>
    <RootNamespace>Cetus</RootNamespace>
    <ApplicationIcon>Assets\cetus.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <FileVersion>0.0.2.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>CETUS鲸鱼座</Product>
    <Copyright>AvroraCL</Copyright>
    <Description>DeepSeek Harness Windows desktop shell</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="SharpVectors.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cetus.Runtime\Cetus.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cetus.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms implicit usings collide with WPF's Application; MainWindow imports them explicitly. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package the native application icon. -->
    <Resource Include="Assets\cetus.ico" />
    <Resource Include="Assets\cetus-splash.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Terminal renderer assets served to the WebView2 via a virtual host. -->
    <Content Include="Assets\Terminal\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
