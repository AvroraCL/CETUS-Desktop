<Window x:Class="Cetus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Cetus · 鲸鱼座"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/cetus.ico"
        Loaded="OnLoaded">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                           ResizeBorderThickness="6"
                           CornerRadius="16"
                           GlassFrameThickness="0"
                           UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- MahApps supplies the base button template, focus behavior and transitions. -->
        <Style x:Key="CaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="0" />
        </Style>

        <Style x:Key="MaximizeCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="Maximized">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RestoreCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="Maximized">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            Background="#F8FAFC"
            CornerRadius="16"
            ClipToBounds="True">
        <Grid>
            <!-- Content fills the entire window (scrolls under the translucent title bar). -->
            <Grid>
                <!-- Status line shown while the DSH host is starting. -->
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="#667"
                           Text="正在启动 DSH 主机…" />

                <!-- The harness GUI, revealed once the host is healthy. -->
                <wv2:WebView2 x:Name="Browser"
                              Visibility="Collapsed"
                              DefaultBackgroundColor="White" />
            </Grid>

            <!--
                70%-translucent title bar overlay. The dark background keeps the
                white SVG logo and caption glyphs legible in both light and dark
                themes; the web content shows through underneath.
            -->
            <Border x:Name="TitleBar"
                    Height="40"
                    VerticalAlignment="Top"
                    Background="#B3222A35">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="最小化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource MaximizeCaptionButton}"
                                ToolTip="最大化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        </Button>
                        <Button x:Name="RestoreButton"
                                Style="{StaticResource RestoreCaptionButton}"
                                ToolTip="还原"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{x:Static SystemCommands.RestoreWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <TextBlock Text="&#xE923;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="关闭到托盘"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <svgc:SvgViewbox Source="pack://application:,,,/Assets/logo.svg"
                                         Width="18" Height="18"
                                         Stretch="Uniform"
                                         Margin="0,0,8,0" />
                        <TextBlock x:Name="TitleText"
                                   Text="Cetus · 鲸鱼座"
                                   Foreground="#FFFFFF"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
