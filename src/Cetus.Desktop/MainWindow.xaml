<Window x:Class="Cetus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CETUS鲸鱼座"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/cetus.ico"
        Loaded="OnLoaded">

    <WindowChrome.WindowChrome>
        <!-- Keep a real, non-layered HWND so WebView2 and DWM share one native
             window shape and dragging stays on the compositor fast path. -->
        <shell:WindowChrome CaptionHeight="40"
                           ResizeBorderThickness="6"
                           CornerRadius="0"
                           GlassFrameThickness="0"
                           UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton"
               TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Foreground">
                <Setter.Value>
                    <SolidColorBrush Color="#F5F7FA" Opacity="0.88" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                CornerRadius="0"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2EFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#4AFFFFFF" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#24FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C50F1F" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaximizeCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="Maximized">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RestoreCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="Maximized">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The native HWND owns live blur; this brush supplies only the tint. -->
        <Border x:Name="TitleBar" Grid.Row="0">
            <Border.Background>
                <SolidColorBrush Color="#151517" Opacity="0.70" />
            </Border.Background>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMinimizeClicked">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Path Data="M 1,6 H 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource MaximizeCaptionButton}"
                            ToolTip="最大化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMaximizeClicked">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Rectangle Width="10" Height="10"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       StrokeThickness="1.35" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="RestoreButton"
                            Style="{StaticResource RestoreCaptionButton}"
                            ToolTip="还原"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnRestoreClicked">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Canvas Width="12" Height="12">
                                <Rectangle Canvas.Left="3" Canvas.Top="0"
                                           Width="8" Height="8"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                           StrokeThickness="1.35" />
                                <Rectangle Canvas.Left="0.5" Canvas.Top="3.5"
                                           Width="8" Height="8"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                           StrokeThickness="1.35" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseCaptionButton}"
                            ToolTip="关闭到托盘"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseToTrayClicked">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image x:Name="BrandLogo"
                           Source="pack://application:,,,/Assets/cetus-titlebar.png"
                           Width="18" Height="18"
                           Stretch="Uniform"
                           Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleText"
                               Text="CETUS鲸鱼座"
                               FontFamily="Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei, Helvetica Neue, Helvetica, Arial"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#F5F7FA" Opacity="0.88" />
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The opaque client plane hides the backdrop below the title band. -->
        <Border x:Name="WindowFrame"
                Grid.Row="1"
                Background="#F8FAFC"
                CornerRadius="0"
                ClipToBounds="False">
            <Grid>
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="#667"
                           Text="正在启动 DSH 主机…" />
                <wv2:WebView2 x:Name="Browser"
                              Visibility="Collapsed"
                              DefaultBackgroundColor="White" />
            </Grid>
        </Border>
    </Grid>
</Window>
