<Window x:Class="Cetus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CETUS鲸鱼座"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/cetus.ico"
        Loaded="OnLoaded">

    <WindowChrome.WindowChrome>
        <!-- Keep a real, non-layered HWND so WebView2 and DWM share one native
             window shape and dragging stays on the compositor fast path. -->
        <shell:WindowChrome CaptionHeight="40"
                           ResizeBorderThickness="6"
                           CornerRadius="0"
                           GlassFrameThickness="0"
                           UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="TitleBarTintBrush" Color="#151517" Opacity="0.70" />
        <SolidColorBrush x:Key="TitleForegroundBrush" Color="#E0F5F7FA" />
        <SolidColorBrush x:Key="CaptionForegroundBrush" Color="#E0F5F7FA" />
        <SolidColorBrush x:Key="CaptionHoverBrush" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="CaptionPressedBrush" Color="#4AFFFFFF" />
        <SolidColorBrush x:Key="CaptionFocusBrush" Color="#24FFFFFF" />

        <Style x:Key="CaptionButton"
               TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource CaptionForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                CornerRadius="0"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionPressedBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionFocusBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C50F1F" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaximizeCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="Maximized">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RestoreCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="Maximized">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The native HWND owns live blur; this brush supplies only the tint. -->
        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="{DynamicResource TitleBarTintBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMinimizeClicked">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Path Data="M 1,6 H 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource MaximizeCaptionButton}"
                            ToolTip="最大化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMaximizeClicked">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Rectangle Width="10" Height="10"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       StrokeThickness="1.35" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="RestoreButton"
                            Style="{StaticResource RestoreCaptionButton}"
                            ToolTip="还原"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnRestoreClicked">
                        <TextBlock Text="&#xE923;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   FontWeight="Normal"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseCaptionButton}"
                            ToolTip="关闭到托盘"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseToTrayClicked">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TitleText"
                           Text="CETUS鲸鱼座"
                           Margin="14,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei, Helvetica Neue, Helvetica, Arial"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}" />
            </DockPanel>
        </Border>

        <!-- The opaque client plane hides the backdrop below the title band. -->
        <Border x:Name="WindowFrame"
                Grid.Row="1"
                Background="#F8FAFC"
                CornerRadius="0"
                ClipToBounds="False">
            <Grid>
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="#667"
                           Text="正在启动 DSH 主机…" />
                <!-- The 6px side/bottom inset keeps the WebView2 child HWND off
                     the resize border: a full-bleed HwndHost captures real
                     mouse hit-testing there and windowed resizing dies. -->
                <wv2:WebView2 x:Name="Browser"
                              Margin="6,0,6,6"
                              Visibility="Collapsed"
                              DefaultBackgroundColor="White" />
                <!-- Safe-mode panel: replaces the bare status line when automatic
                     DSH recovery is exhausted. -->
                <Border x:Name="DiagnosticsPanel"
                        Visibility="Collapsed"
                        Padding="48,28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock x:Name="DiagnosticsTitle"
                                       Text="DSH 启动失败"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#B4232A" />
                            <TextBlock x:Name="DiagnosticsSummary"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#667" />
                        </StackPanel>
                        <TextBox x:Name="DiagnosticsDetail"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Cascadia Mono"
                                 FontSize="12"
                                 Padding="10"
                                 BorderThickness="1"
                                 BorderBrush="#D5DCE8"
                                 Background="#F0F3F8"
                                 Foreground="#333A45" />
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="0,14,0,0">
                            <Button Content="重试连接 DSH"
                                    Padding="16,6" Margin="0,0,10,0"
                                    Click="OnDiagnosticsRetryClicked" />
                            <Button Content="打开日志文件夹"
                                    Padding="16,6" Margin="0,0,10,0"
                                    Click="OnDiagnosticsOpenLogsClicked" />
                            <Button Content="复制诊断信息"
                                    Padding="16,6" Margin="0,0,10,0"
                                    Click="OnDiagnosticsCopyClicked" />
                            <Button Content="导出诊断包…"
                                    Padding="16,6" Margin="0,0,10,0"
                                    Click="OnDiagnosticsExportClicked" />
                            <Button Content="退出 CETUS"
                                    Padding="16,6"
                                    Click="OnDiagnosticsExitClicked" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
