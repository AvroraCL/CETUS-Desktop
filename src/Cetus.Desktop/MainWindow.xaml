<Window x:Class="Cetus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:sidebar="clr-namespace:Cetus.Sidebar"
        Title="CETUS鲸鱼座"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/cetus.ico"
        Loaded="OnLoaded">

    <WindowChrome.WindowChrome>
        <!-- Keep a real, non-layered HWND so WebView2 and DWM share one native
             window shape and dragging stays on the compositor fast path. -->
        <shell:WindowChrome CaptionHeight="40"
                           ResizeBorderThickness="6"
                           CornerRadius="0"
                           GlassFrameThickness="0"
                           UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="TitleBarTintBrush" Color="#151517" Opacity="0.70" />
        <SolidColorBrush x:Key="TitleForegroundBrush" Color="#E0F5F7FA" />
        <SolidColorBrush x:Key="CaptionForegroundBrush" Color="#E0F5F7FA" />
        <SolidColorBrush x:Key="CaptionHoverBrush" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="CaptionPressedBrush" Color="#4AFFFFFF" />
        <SolidColorBrush x:Key="CaptionFocusBrush" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="RightSidebarBackgroundBrush" Color="#1B1B1C" />
        <SolidColorBrush x:Key="SidebarPanelForegroundBrush" Color="#F9FAFB" />
        <SolidColorBrush x:Key="SidebarPanelSecondaryBrush" Color="#CFD3D6" />
        <SolidColorBrush x:Key="SidebarPanelSelectedBrush" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="SidebarPanelInputBrush" Color="#222224" />
        <SolidColorBrush x:Key="SidebarTerminalBackgroundBrush" Color="#101011" />
        <SolidColorBrush x:Key="SidebarTerminalForegroundBrush" Color="#E5E7EB" />

        <Style x:Key="CaptionButton"
               TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource CaptionForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                CornerRadius="0"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionPressedBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionFocusBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C50F1F" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaximizeCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="Maximized">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RestoreCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="Maximized">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The native HWND owns live blur; this brush supplies only the tint. -->
        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="{DynamicResource TitleBarTintBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMinimizeClicked">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Path Data="M 1,6 H 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource MaximizeCaptionButton}"
                            ToolTip="最大化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMaximizeClicked">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Rectangle Width="10" Height="10"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       StrokeThickness="1.35" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="RestoreButton"
                            Style="{StaticResource RestoreCaptionButton}"
                            ToolTip="还原"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnRestoreClicked">
                        <TextBlock Text="&#xE923;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   FontWeight="Normal"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseCaptionButton}"
                            ToolTip="关闭到托盘"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseToTrayClicked">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TitleText"
                           Text="CETUS鲸鱼座"
                           Margin="14,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei, Helvetica Neue, Helvetica, Arial"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}" />
            </DockPanel>
        </Border>

        <!-- The opaque client plane hides the backdrop below the title band. -->
        <Border x:Name="WindowFrame"
                Grid.Row="1"
                Background="#F8FAFC"
                CornerRadius="0"
                ClipToBounds="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RightSidebarDividerColumn" Width="8" />
                    <ColumnDefinition x:Name="RightSidebarColumn" Width="360" MaxWidth="520" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock x:Name="StatusText"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" Foreground="#667"
                               Text="正在启动 DSH 主机…" />
                    <wv2:WebView2 x:Name="Browser"
                                  Visibility="Collapsed"
                                  DefaultBackgroundColor="White" />
                </Grid>

                <Border x:Name="RightSidebarDivider"
                        Grid.Column="1"
                        Panel.ZIndex="1"
                        Width="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource SidebarBorderBrush}"
                        Visibility="{Binding Visibility, ElementName=RightSidebarSplitter}" />

                <GridSplitter x:Name="RightSidebarSplitter"
                              Grid.Column="1"
                              Panel.ZIndex="2"
                              Margin="0,60,0,0"
                              Width="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False"
                              DragStarted="OnRightSidebarDragStarted"
                              DragCompleted="OnRightSidebarDragCompleted">
                    <GridSplitter.Template>
                        <!-- Invisible hit zone: the 1px divider is the only visual. -->
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent" />
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Border x:Name="RightSidebar"
                        Grid.Column="2"
                        Background="{DynamicResource RightSidebarBackgroundBrush}">
                    <sidebar:RightSidebarView x:Name="RightSidebarContent" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
