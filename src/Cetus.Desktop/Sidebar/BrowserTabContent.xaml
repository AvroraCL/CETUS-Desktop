<UserControl x:Class="Cetus.Sidebar.BrowserTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cetus.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="后退"
                    IsEnabled="False"
                    Click="OnBackClicked">
                <controls:FluentIcon Kind="ArrowLeft" IconSize="14" />
            </Button>
            <Button x:Name="ForwardButton"
                    Grid.Column="1"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="前进"
                    IsEnabled="False"
                    Click="OnForwardClicked">
                <controls:FluentIcon Kind="ArrowRight" IconSize="14" />
            </Button>
            <Button Grid.Column="2"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="刷新"
                    Click="OnRefreshClicked">
                <controls:FluentIcon Kind="ArrowClockwise" IconSize="14" />
            </Button>
            <!-- Rounded address pill; Enter navigates (no separate Go button). -->
            <Border Grid.Column="3"
                    Margin="4,6"
                    CornerRadius="8"
                    Background="{DynamicResource SidebarPanelInputBrush}"
                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <TextBox x:Name="AddressBox"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8,5"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource SidebarPanelForegroundBrush}"
                             CaretBrush="{DynamicResource SidebarPanelForegroundBrush}"
                             ToolTip="输入网址或搜索内容"
                             TextChanged="OnAddressChanged"
                             KeyDown="OnAddressKeyDown" />
                    <TextBlock x:Name="AddressPlaceholder"
                               Text="输入网址后回车"
                               FontSize="12"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>
            <Button x:Name="PickElementButton"
                    Grid.Column="4"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="选择网页元素加入聊天"
                    Click="OnPickElementClicked">
                <controls:FluentIcon Kind="SelectObject" IconSize="14" />
            </Button>
        </Grid>
        <wv2:WebView2 x:Name="TabWeb"
                      Grid.Row="1"
                      DefaultBackgroundColor="#1B1B1C" />
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="6,0,6,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
