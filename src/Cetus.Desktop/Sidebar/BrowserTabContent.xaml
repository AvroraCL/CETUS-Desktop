<UserControl x:Class="Cetus.Sidebar.BrowserTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="后退"
                    IsEnabled="False"
                    Click="OnBackClicked">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE72B;" />
            </Button>
            <Button x:Name="ForwardButton"
                    Grid.Column="1"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="前进"
                    IsEnabled="False"
                    Click="OnForwardClicked">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE72A;" />
            </Button>
            <Button Grid.Column="2"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="刷新"
                    Click="OnRefreshClicked">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE72C;" />
            </Button>
            <Grid Grid.Column="3" Margin="4,0">
                <TextBox x:Name="AddressBox"
                         Style="{StaticResource SidebarTextBox}"
                         FontSize="12"
                         ToolTip="输入网址或搜索内容"
                         TextChanged="OnAddressChanged"
                         KeyDown="OnAddressKeyDown" />
                <TextBlock x:Name="AddressPlaceholder"
                           Text="输入网址后回车"
                           FontSize="12"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                           IsHitTestVisible="False" />
            </Grid>
            <Button Grid.Column="4"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="打开"
                    Click="OnGoClicked">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE72A;" />
            </Button>
        </Grid>
        <wv2:WebView2 x:Name="TabWeb"
                      Grid.Row="1"
                      DefaultBackgroundColor="#1B1B1C" />
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="6,0,6,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
