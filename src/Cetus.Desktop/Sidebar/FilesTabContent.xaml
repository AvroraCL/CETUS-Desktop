<UserControl x:Class="Cetus.Sidebar.FilesTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cetus.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox"
                     Grid.Column="0"
                     Margin="0,0,4,0"
                     Style="{StaticResource SidebarTextBox}"
                     FontSize="12"
                     IsReadOnly="True" />
            <Button Grid.Column="1"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="选择目录"
                    Click="OnChooseFolderClicked">
                <controls:FluentIcon Kind="Folder" IconSize="14" />
            </Button>
            <Button Grid.Column="2"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="刷新"
                    Click="OnRefreshClicked">
                <controls:FluentIcon Kind="ArrowClockwise" IconSize="14" />
            </Button>
        </Grid>
        <TreeView x:Name="FilesTree"
                  Grid.Row="1"
                  Margin="6,0,6,6"
                  Padding="4"
                  Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Foreground="{DynamicResource SidebarPanelForegroundBrush}"
                  TreeViewItem.Expanded="OnFileNodeExpanded"
                  MouseDoubleClick="OnFileNodeDoubleClicked">
            <TreeView.Resources>
                <Style TargetType="TreeViewItem">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SidebarPanelForegroundBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <controls:FluentIcon Width="20"
                                             Height="18"
                                             VerticalAlignment="Center"
                                             Kind="{Binding IconKind}"
                                             IconSize="14"
                                             Foreground="{DynamicResource SidebarPanelSecondaryBrush}" />
                        <TextBlock VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Foreground="{DynamicResource SidebarPanelForegroundBrush}"
                                   Text="{Binding Name}"
                                   ToolTip="{Binding FullPath}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
