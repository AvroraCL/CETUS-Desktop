<UserControl x:Class="Cetus.Sidebar.FilesTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cetus.Controls">
    <UserControl.Resources>
        <!-- Slim expander glyph: triangle right (collapsed) / down (expanded). -->
        <ControlTemplate x:Key="CetusTreeExpander"
                         TargetType="ToggleButton">
            <Border Width="14"
                    Height="16"
                    Background="Transparent">
                <Path x:Name="Glyph"
                      Data="M 3 2 L 10 6.5 L 3 11 Z"
                      Fill="{DynamicResource SidebarPanelSecondaryBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Path.RenderTransform>
                </Path>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Glyph"
                            Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <!-- Same rounded pill as the browser address bar. -->
            <Border Grid.Column="0"
                    Margin="0,6,4,6"
                    CornerRadius="8"
                    Background="{DynamicResource SidebarPanelInputBrush}"
                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="1"
                    ToolTip="当前 DSH 会话工作区">
                <TextBox x:Name="PathBox"
                         FontSize="12"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,5"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource SidebarPanelForegroundBrush}"
                         CaretBrush="{DynamicResource SidebarPanelForegroundBrush}" />
            </Border>
            <Button Grid.Column="1"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="刷新"
                    Click="OnRefreshClicked">
                <controls:FluentIcon Kind="ArrowClockwise" IconSize="14" />
            </Button>
        </Grid>
        <Grid Grid.Row="1" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="110" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="150" MinWidth="100" MaxWidth="300" />
            </Grid.ColumnDefinitions>
            <!-- Preview pane (left) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="PreviewHeader"
                           Grid.Row="0"
                           Margin="2,2,2,4"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SidebarPanelSecondaryBrush}" />
                <Grid Grid.Row="1"
                      Background="{DynamicResource SidebarPanelInputBrush}">
                    <ListBox x:Name="PreviewLines"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Line"
                                           Text="{Binding Text}"
                                           FontFamily="Consolas, 'Cascadia Mono', monospace"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SidebarPanelForegroundBrush}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsNotice}" Value="True">
                                        <Setter TargetName="Line"
                                                Property="Foreground"
                                                Value="{DynamicResource SidebarPanelSecondaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ScrollViewer x:Name="PreviewImageHost"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Background="Transparent">
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="8" />
                    </ScrollViewer>
                    <StackPanel x:Name="PreviewNoticePanel"
                                Visibility="Visible"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:FluentIcon Kind="Document"
                                             IconSize="20"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource SidebarPanelSecondaryBrush}" />
                        <TextBlock x:Name="PreviewNoticeText"
                                   Margin="12,8,12,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <!-- Edge-line divider: visible 1px line with a 12px grab strip. -->
            <GridSplitter Grid.Column="1"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Focusable="False"
                          Cursor="SizeWE">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Width="1"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource SidebarBorderBrush}" />
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>
            <!-- File tree (right, narrow) -->
            <TreeView x:Name="FilesTree"
                      Grid.Column="2"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      Foreground="{DynamicResource SidebarPanelForegroundBrush}"
                      TreeViewItem.Expanded="OnFileNodeExpanded"
                      SelectedItemChanged="OnFileSelected"
                      MouseDoubleClick="OnFileNodeDoubleClicked">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground"
                                Value="{DynamicResource SidebarPanelForegroundBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="IsExpanded"
                                Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <StackPanel>
                                        <Border x:Name="Row"
                                                CornerRadius="4"
                                                Padding="0,1"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton x:Name="Expander"
                                                              Focusable="False"
                                                              ClickMode="Press"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                              Template="{StaticResource CetusTreeExpander}" />
                                                <ContentPresenter Grid.Column="1"
                                                                  ContentSource="Header"
                                                                  HorizontalAlignment="Left" />
                                            </Grid>
                                        </Border>
                                        <ItemsPresenter x:Name="ItemsHost" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="False">
                                            <Setter TargetName="ItemsHost"
                                                    Property="Visibility"
                                                    Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Expander"
                                                    Property="Visibility"
                                                    Value="Hidden" />
                                        </Trigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row"
                                                    Property="Background"
                                                    Value="{DynamicResource SidebarPanelSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row"
                                                    Property="Background"
                                                    Value="{DynamicResource SidebarPanelSelectedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <controls:FluentIcon Width="16"
                                                 Height="16"
                                                 VerticalAlignment="Center"
                                                 Kind="{Binding IconKind}"
                                                 IconSize="14"
                                                 Foreground="{DynamicResource SidebarPanelSecondaryBrush}" />
                            <TextBlock VerticalAlignment="Center"
                                       Margin="4,0,2,0"
                                       Foreground="{DynamicResource SidebarPanelForegroundBrush}"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FullPath}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Grid>
</UserControl>
