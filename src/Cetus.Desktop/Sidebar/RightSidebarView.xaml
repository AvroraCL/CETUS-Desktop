<UserControl x:Class="Cetus.Sidebar.RightSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{DynamicResource SidebarPanelForegroundBrush}">
    <UserControl.Resources>
        <Style x:Key="SidebarTabTypeCard" TargetType="Button">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="84" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SidebarPanelInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarPanelForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                           Text="{TemplateBinding Tag}" />
                                <TextBlock Text="{TemplateBinding Content}"
                                           Margin="0,8,0,0"
                                           FontSize="13"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource SidebarPanelSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarMenuRow" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarPanelForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource SidebarPanelSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 60px matches the injected DSH top bar so the strip's bottom
                 line connects with the DSH top bar's own bottom line. -->
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="6,5">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource SidebarIconButton}"
                        ToolTip="新建标签页"
                        x:Name="NewTabButton"
                        Click="OnNewTabClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE710;" />
                </Button>
                <Button DockPanel.Dock="Left"
                        x:Name="TabsMenuButton"
                        Style="{StaticResource SidebarIconButton}"
                        ToolTip="标签页列表"
                        Click="OnTabsMenuClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE70D;" />
                </Button>
                <ScrollViewer VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="TabStripPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <ContentControl x:Name="ActiveTabHost" />
            <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed">
                <TextBlock Text="打开标签页"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SidebarPanelForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,60,0,0" />
                <TextBlock Text="选择要在侧边面板中打开的类型。"
                           FontSize="13"
                           Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
                <WrapPanel HorizontalAlignment="Center" Margin="0,28,0,0">
                    <Button Style="{StaticResource SidebarTabTypeCard}"
                            Tag="&#xE774;"
                            Content="浏览器"
                            Click="OnEmptyBrowserClicked" />
                    <Button Style="{StaticResource SidebarTabTypeCard}"
                            Tag="&#xE756;"
                            Content="终端"
                            Click="OnEmptyTerminalClicked" />
                    <Button Style="{StaticResource SidebarTabTypeCard}"
                            Tag="&#xE8B7;"
                            Content="文件"
                            Click="OnEmptyFilesClicked" />
                </WrapPanel>
            </StackPanel>
            <!-- Mirrors the DSH in-page modal mask: when a real modal
                 ([role=dialog][aria-modal=true]) opens on the page, the panel
                 dims and stops taking clicks until it closes. -->
            <Border x:Name="ModalDim"
                    Background="#80000000"
                    IsHitTestVisible="True"
                    Visibility="Collapsed" />
        </Grid>

        <Popup x:Name="NewTabMenuPopup"
               PlacementTarget="{Binding ElementName=NewTabButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="OnNewTabMenuPopupClosed">
            <Border Background="{DynamicResource SidebarPanelInputBrush}"
                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    Margin="0,4,8,0"
                    MinWidth="150">
                <StackPanel>
                    <Button Style="{StaticResource SidebarMenuRow}" Click="OnMenuBrowserClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE774;" />
                            <TextBlock Text="浏览器" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarMenuRow}" Click="OnMenuTerminalClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE756;" />
                            <TextBlock Text="终端" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarMenuRow}" Click="OnMenuFilesClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8B7;" />
                            <TextBlock Text="文件" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="TabsMenuPopup"
               PlacementTarget="{Binding ElementName=TabsMenuButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="OnTabsMenuPopupClosed">
            <Border x:Name="TabsMenuBorder"
                    Background="{DynamicResource SidebarPanelInputBrush}"
                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    Margin="0,4,8,0"
                    MinWidth="260"
                    MaxHeight="440">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <Grid Margin="2,2,2,6">
                        <TextBox x:Name="TabSearchBox"
                                 Style="{StaticResource SidebarTextBox}"
                                 FontSize="12"
                                 TextChanged="OnTabSearchChanged" />
                        <TextBlock x:Name="TabSearchPlaceholder"
                                   Text="搜索标签页..."
                                   FontSize="12"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                   IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="打开的标签页"
                               FontSize="12"
                               Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                               Margin="6,2,0,4"
                               x:Name="OpenTabsHeader" />
                    <StackPanel x:Name="OpenTabsHost" />
                    <TextBlock Text="最近关闭的标签页"
                               FontSize="12"
                               Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                               Margin="6,10,0,4"
                               x:Name="ClosedTabsHeader" />
                    <StackPanel x:Name="ClosedTabsHost" />
                    <TextBlock x:Name="NoMatchHint"
                               Text="无匹配标签页"
                               FontSize="12"
                               Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                               Margin="6,8,0,6"
                               Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
