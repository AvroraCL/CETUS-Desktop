<UserControl x:Class="Cetus.Sidebar.RightSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="Transparent"
             Foreground="{DynamicResource SidebarPanelForegroundBrush}"
             PreviewKeyDown="OnSidebarPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="SidebarIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarPanelSecondaryBrush}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource CaptionHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource CaptionPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTabButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarPanelSecondaryBrush}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource CaptionHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource SidebarPanelSelectedBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SidebarPanelForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource SidebarPanelForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource SidebarPanelInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ToggleButton x:Name="BrowserTabButton"
                              Style="{StaticResource SidebarTabButton}"
                              ToolTip="浏览器"
                              IsChecked="True"
                              Click="OnBrowserTabClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Text="&#xE774;" />
                </ToggleButton>
                <ToggleButton x:Name="TerminalTabButton"
                              Style="{StaticResource SidebarTabButton}"
                              ToolTip="终端"
                              Click="OnTerminalTabClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Text="&#xE756;" />
                </ToggleButton>
                <ToggleButton x:Name="FilesTabButton"
                              Style="{StaticResource SidebarTabButton}"
                              ToolTip="文件"
                              Click="OnFilesTabClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Text="&#xE8B7;" />
                </ToggleButton>
            </StackPanel>
        </Border>

        <Grid x:Name="BrowserPanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BrowserBackButton"
                        Grid.Column="0"
                        Style="{StaticResource SidebarIconButton}"
                        ToolTip="后退"
                        IsEnabled="False"
                        Click="OnBrowserBackClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE72B;" />
                </Button>
                <Button x:Name="BrowserForwardButton"
                        Grid.Column="1"
                        Style="{StaticResource SidebarIconButton}"
                        ToolTip="前进"
                        IsEnabled="False"
                        Click="OnBrowserForwardClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE72A;" />
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource SidebarIconButton}"
                        ToolTip="刷新"
                        Click="OnBrowserRefreshClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE72C;" />
                </Button>
                <TextBox x:Name="BrowserAddressBox"
                         Grid.Column="3"
                         Margin="4,0"
                         Style="{StaticResource SidebarTextBox}"
                         FontSize="12"
                         ToolTip="输入网址或搜索内容"
                         GotKeyboardFocus="OnBrowserAddressGotKeyboardFocus"
                         PreviewMouseLeftButtonDown="OnBrowserAddressPreviewMouseDown"
                         KeyDown="OnBrowserAddressKeyDown" />
                <Button Grid.Column="4"
                        Style="{StaticResource SidebarIconButton}"
                        ToolTip="打开"
                        Click="OnBrowserGoClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE72A;" />
                </Button>
            </Grid>
            <wv2:WebView2 x:Name="SidebarBrowser"
                          Grid.Row="1"
                          DefaultBackgroundColor="#1B1B1C" />
            <TextBlock x:Name="BrowserStatusText"
                       Grid.Row="2"
                       Margin="10,0,10,8"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                       Visibility="Collapsed" />
        </Grid>

        <Grid x:Name="TerminalPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <TextBox x:Name="TerminalOutput"
                     Grid.Row="0"
                     Margin="6,6,6,0"
                     Padding="8"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="12"
                     Foreground="{DynamicResource SidebarTerminalForegroundBrush}"
                     Background="{DynamicResource SidebarTerminalBackgroundBrush}"
                     BorderBrush="{DynamicResource SidebarBorderBrush}" />
            <Grid Grid.Row="1" Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TerminalInput"
                         Grid.Column="0"
                         Margin="0,0,4,0"
                         Style="{StaticResource SidebarTextBox}"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="12"
                         ToolTip="输入 PowerShell 命令"
                         KeyDown="OnTerminalInputKeyDown" />
                <Button Grid.Column="1"
                        Style="{StaticResource SidebarIconButton}"
                        ToolTip="执行"
                        Click="OnTerminalRunClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE768;" />
                </Button>
            </Grid>
        </Grid>

        <Grid x:Name="FilesPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilesPathBox"
                         Grid.Column="0"
                         Margin="0,0,4,0"
                         Style="{StaticResource SidebarTextBox}"
                         FontSize="12"
                         IsReadOnly="True" />
                <Button Grid.Column="1"
                        Style="{StaticResource SidebarIconButton}"
                        ToolTip="选择目录"
                        Click="OnChooseFolderClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE838;" />
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource SidebarIconButton}"
                        ToolTip="刷新"
                        Click="OnFilesRefreshClicked">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE72C;" />
                </Button>
            </Grid>
            <TreeView x:Name="FilesTree"
                      Grid.Row="1"
                      Margin="6,0,6,6"
                      Padding="4"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource SidebarPanelForegroundBrush}"
                      TreeViewItem.Expanded="OnFileNodeExpanded"
                      MouseDoubleClick="OnFileNodeDoubleClicked">
                <TreeView.Resources>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground"
                                Value="{DynamicResource SidebarPanelForegroundBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </TreeView.Resources>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="20"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                       Text="{Binding Glyph}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource SidebarPanelForegroundBrush}"
                                       Text="{Binding Name}"
                                       ToolTip="{Binding FullPath}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Grid>
</UserControl>
