<UserControl x:Class="Cetus.Sidebar.RightSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cetus.Controls"
             Background="Transparent"
             Foreground="{DynamicResource SidebarPanelForegroundBrush}">
    <UserControl.Resources>
        <!-- Close chip on tab pills: a comfortable 22px rounded button. -->
        <Style x:Key="SidebarCloseChip" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource SidebarPanelInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarPanelForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource SidebarPanelSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DSH-style slim scrollbar for every panel tab (files, status,
             popups): 8px invisible track, rounded translucent thumb. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        CornerRadius="4"
                                                        Background="#2EFFFFFF" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#55FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#80FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTabTypeCard" TargetType="Button">
            <Setter Property="Width" Value="148" />
            <Setter Property="Height" Value="88" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SidebarPanelInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarPanelForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <controls:FluentIcon Kind="{TemplateBinding Tag}"
                                                     IconSize="20"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource SidebarPanelSecondaryBrush}" />
                                <TextBlock Text="{TemplateBinding Content}"
                                           Margin="0,8,0,0"
                                           FontSize="13"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource SidebarPanelSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarMenuRow" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarPanelForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource SidebarPanelSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 60px matches the injected DSH top bar so the strip's bottom
                 line connects with the DSH top bar's own bottom line. -->
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="6,5">
                <Button DockPanel.Dock="Left"
                        x:Name="TabsMenuButton"
                        Style="{StaticResource SidebarIconButton}"
                        ToolTip="标签页列表"
                        Click="OnTabsMenuClicked">
                    <controls:FluentIcon Kind="ChevronDown" IconSize="12" />
                </Button>
                <ScrollViewer VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Hidden">
                    <!-- Pills are inserted before the trailing new-tab button,
                         so the + always follows the last tab. -->
                    <StackPanel x:Name="TabStripPanel" Orientation="Horizontal">
                        <Button x:Name="NewTabButton"
                                Style="{StaticResource SidebarIconButton}"
                                Background="{DynamicResource SidebarPanelInputBrush}"
                                ToolTip="新建标签页"
                                Click="OnNewTabClicked">
                            <controls:FluentIcon Kind="Add" IconSize="14" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- The left 12px gutter is the resize grab zone carved out of
                 WebView2 airspace: the DSH main surface stays flush against
                 the divider, so tab content must keep this margin or the
                 strip would sit on top of the web surface and lose hit
                 testing to the HWND underneath. -->
            <ContentControl x:Name="ActiveTabHost" Margin="12,0,0,0" />
            <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed">
                <TextBlock Text="打开标签页"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SidebarPanelForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,60,0,0" />
                <TextBlock Text="选择要在侧边面板中打开的标签。"
                           FontSize="13"
                           Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
                <WrapPanel HorizontalAlignment="Center" Margin="0,28,0,0">
                    <Button Style="{StaticResource SidebarTabTypeCard}"
                            Tag="Globe"
                            Content="浏览器"
                            Click="OnEmptyBrowserClicked" />
                    <Button Style="{StaticResource SidebarTabTypeCard}"
                            Tag="Code"
                            Content="终端"
                            Click="OnEmptyTerminalClicked" />
                    <Button Style="{StaticResource SidebarTabTypeCard}"
                            Tag="Folder"
                            Content="文件"
                            Click="OnEmptyFilesClicked" />
                    <Button Style="{StaticResource SidebarTabTypeCard}"
                            Tag="DataUsage"
                            Content="状态"
                            Click="OnEmptyStatusClicked" />
                    <Button Style="{StaticResource SidebarTabTypeCard}"
                            Tag="ClipboardTask"
                            Content="审查"
                            Click="OnEmptyReviewClicked" />
                </WrapPanel>
            </StackPanel>
            <!-- Mirrors the DSH in-page modal mask: when a real modal
                 ([role=dialog][aria-modal=true]) opens on the page, the whole
                 panel — tab strip included — dims and stops taking clicks
                 until it closes. -->
            <Border x:Name="ModalDim"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="#80000000"
                    IsHitTestVisible="True"
                    Visibility="Collapsed" />
        </Grid>

        <Popup x:Name="NewTabMenuPopup"
               PlacementTarget="{Binding ElementName=NewTabButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="OnNewTabMenuPopupClosed">
                    <Border Background="{DynamicResource SidebarPanelInputBrush}"
                            BorderBrush="{DynamicResource SidebarBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6"
                            Margin="0,4,8,0"
                            MinWidth="170">

                <StackPanel>
                    <Button Style="{StaticResource SidebarMenuRow}" Click="OnMenuBrowserClicked">
                        <StackPanel Orientation="Horizontal">
                            <controls:FluentIcon Kind="Globe" IconSize="14" />
                            <TextBlock Text="浏览器" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarMenuRow}" Click="OnMenuTerminalClicked">
                        <StackPanel Orientation="Horizontal">
                            <controls:FluentIcon Kind="Code" IconSize="14" />
                            <TextBlock Text="终端" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarMenuRow}" Click="OnMenuFilesClicked">
                        <StackPanel Orientation="Horizontal">
                            <controls:FluentIcon Kind="Folder" IconSize="14" />
                            <TextBlock Text="文件" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarMenuRow}" Click="OnMenuReviewClicked">
                        <StackPanel Orientation="Horizontal">
                            <controls:FluentIcon Kind="ClipboardTask" IconSize="14" />
                            <TextBlock Text="审查" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="TabsMenuPopup"
               PlacementTarget="{Binding ElementName=TabsMenuButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="OnTabsMenuPopupClosed">
            <Border x:Name="TabsMenuBorder"
                    Background="{DynamicResource SidebarPanelInputBrush}"
                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    Margin="0,4,8,0"
                    MinWidth="260"
                    MaxHeight="440">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <Grid Margin="2,2,2,6">
                        <TextBox x:Name="TabSearchBox"
                                 Style="{StaticResource SidebarTextBox}"
                                 FontSize="12"
                                 TextChanged="OnTabSearchChanged" />
                        <TextBlock x:Name="TabSearchPlaceholder"
                                   Text="搜索标签页..."
                                   FontSize="12"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                   IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="打开的标签页"
                               FontSize="12"
                               Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                               Margin="6,2,0,4"
                               x:Name="OpenTabsHeader" />
                    <StackPanel x:Name="OpenTabsHost" />
                    <TextBlock Text="最近关闭的标签页"
                               FontSize="12"
                               Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                               Margin="6,10,0,4"
                               x:Name="ClosedTabsHeader" />
                    <StackPanel x:Name="ClosedTabsHost" />
                    <TextBlock x:Name="NoMatchHint"
                               Text="无匹配标签页"
                               FontSize="12"
                               Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                               Margin="6,8,0,6"
                               Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
