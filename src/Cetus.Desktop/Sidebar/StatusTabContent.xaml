<UserControl x:Class="Cetus.Sidebar.StatusTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarPanelInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="8,8,8,0" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarPanelSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="状态"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="刷新"
                    x:Name="RefreshButton"
                    Click="OnRefreshClicked">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE72C;" />
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,10">
                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="当前项目" Style="{StaticResource StatusLabel}" Margin="0" />
                        <TextBlock x:Name="WorkspaceTitleText" Style="{StaticResource StatusValue}" Text="—" />
                        <TextBlock x:Name="WorkspacePathText"
                                   FontSize="11"
                                   FontFamily="Cascadia Mono, Consolas"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock x:Name="WorkspaceMetaText"
                                   FontSize="11"
                                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="模型" Style="{StaticResource StatusLabel}" Margin="0" />
                        <TextBlock x:Name="ModelText" Style="{StaticResource StatusValue}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="Token 用量（全部会话累计）" Style="{StaticResource StatusLabel}" Margin="0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="输入" Style="{StaticResource StatusLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InputTokensText" Style="{StaticResource StatusValue}" Text="0" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="输出" Style="{StaticResource StatusLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OutputTokensText" Style="{StaticResource StatusValue}" Text="0" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="缓存读取" Style="{StaticResource StatusLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CacheReadText" Style="{StaticResource StatusValue}" Text="0" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="缓存写入" Style="{StaticResource StatusLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CacheWriteText" Style="{StaticResource StatusValue}" Text="0" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="累计调用（全部会话）" Style="{StaticResource StatusLabel}" Margin="0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="会话" Style="{StaticResource StatusLabel}" Margin="0" />
                                <TextBlock x:Name="SessionsText" Style="{StaticResource StatusValue}" Text="0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="轮次" Style="{StaticResource StatusLabel}" Margin="0" />
                                <TextBlock x:Name="TurnsText" Style="{StaticResource StatusValue}" Text="0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="步骤" Style="{StaticResource StatusLabel}" Margin="0" />
                                <TextBlock x:Name="StepsText" Style="{StaticResource StatusValue}" Text="0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="DeepSeek 余额" Style="{StaticResource StatusLabel}" Margin="0" />
                        <TextBlock x:Name="BalanceText" Style="{StaticResource StatusValue}" Text="—" />
                        <TextBlock x:Name="BalanceDetailText"
                                   FontSize="11"
                                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="UpdatedText"
                           Margin="10,8,10,0"
                           FontSize="11"
                           Foreground="{DynamicResource SidebarPanelSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
