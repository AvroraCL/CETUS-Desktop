<UserControl x:Class="Cetus.Sidebar.StatusTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarPanelInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="8,8,8,0" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarPanelSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StatusBigValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="LegendDot" TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="状态"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Style="{StaticResource SidebarIconButton}"
                    ToolTip="刷新"
                    x:Name="RefreshButton"
                    Click="OnRefreshClicked">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE72C;" />
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,10">
                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="当前项目" Style="{StaticResource StatusLabel}" Margin="0" />
                        <TextBlock x:Name="WorkspaceTitleText" Style="{StaticResource StatusBigValue}" Text="—" />
                        <TextBlock x:Name="WorkspacePathText"
                                   FontSize="11"
                                   FontFamily="Cascadia Mono, Consolas"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock x:Name="WorkspaceMetaText"
                                   FontSize="11"
                                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="模型" Style="{StaticResource StatusLabel}" />
                        <TextBlock x:Name="ModelText" Style="{StaticResource StatusValue}" Text="—" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Token 用量" Style="{StaticResource StatusLabel}" Margin="0" />
                            <TextBlock x:Name="TotalTokensText"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <Grid x:Name="UsageBarHost" Height="10">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,1000,10" RadiusX="5" RadiusY="5" />
                            </Grid.Clip>
                        </Grid>
                        <TextBlock x:Name="UsageEmptyText"
                                   Text="暂无会话数据"
                                   FontSize="12"
                                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <WrapPanel x:Name="UsageLegend" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="最近会话 · 输出 Token" Style="{StaticResource StatusLabel}" Margin="0" />
                            <TextBlock Text="悬停查看详情"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{DynamicResource SidebarPanelSecondaryBrush}" />
                        </Grid>
                        <Grid x:Name="SessionBarsHost" Height="90" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="SessionBarsEmptyText"
                                   Text="暂无会话数据"
                                   FontSize="12"
                                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="累计调用（全部会话）" Style="{StaticResource StatusLabel}" Margin="0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="会话" Style="{StaticResource StatusLabel}" Margin="0" HorizontalAlignment="Center" />
                                <TextBlock x:Name="SessionsText" Style="{StaticResource StatusBigValue}" Text="0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="轮次" Style="{StaticResource StatusLabel}" Margin="0" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TurnsText" Style="{StaticResource StatusBigValue}" Text="0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="步骤" Style="{StaticResource StatusLabel}" Margin="0" HorizontalAlignment="Center" />
                                <TextBlock x:Name="StepsText" Style="{StaticResource StatusBigValue}" Text="0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <TextBlock Text="DeepSeek 余额" Style="{StaticResource StatusLabel}" Margin="0" />
                        <TextBlock x:Name="BalanceText" Style="{StaticResource StatusBigValue}" Text="—" />
                        <Grid x:Name="BalanceBarHost" Height="8" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,1000,8" RadiusX="4" RadiusY="4" />
                            </Grid.Clip>
                        </Grid>
                        <TextBlock x:Name="BalanceDetailText"
                                   FontSize="11"
                                   Foreground="{DynamicResource SidebarPanelSecondaryBrush}"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="UpdatedText"
                           Margin="10,8,10,0"
                           FontSize="11"
                           Foreground="{DynamicResource SidebarPanelSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
